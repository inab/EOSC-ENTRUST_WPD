{
    "name": "WfExS TES template HELLO WORLD complete v4",
    "description": "Complete TES template v3 for execution hello world.",
    "outputs": [
        {
            "name": "outputs",
            "description": "The WRROC and outputs dir",
            "path": "/outputs",
            "url": "s3://",
            "type": "DIRECTORY"
        }
    ],
    "volumes": [
        "/shared/"
    ],
    "executors": [
        {
            "image": "ubuntu:24.04",
            "env": {
                "input__an_input": "SRR7890919_WES_HCC1395BL-EA_normal_1.fastq.gz",
                "__analysis__": "hello"
            },
            "command": [
                "/bin/bash",
                "-c",
                "export XDG_CACHE_HOME=\"/workflows/${__analysis__}/side_caches\" ; export WFEXS_CONFIG_FILE=\"/workflows/${__analysis__}/funnel_tre_wfexs_restricted.yaml\" ; export WRROC=\"/workflows/${__analysis__}/wrroc.zip\" ; export ENCRYPTED_PATH=\"/inputs/${TRE_INPUT_ID}\" ; export DECRYPTED_PATH=\"/shared/datasets/${TRE_INPUT_ID}\" ; export _input__an_input=\"${DECRYPTED_PATH}/$input__an_input\" ; mkdir -p /outputs/analysis_outputs /outputs/tes_logs \"${DECRYPTED_PATH}\" /shared/.parameters ; chmod go+w /outputs/tes_logs ; chmod ugo+rwxt /tmp ; echo \"$TRE_INPUT_CREDENTIALS\" > /shared/.parameters/.credentials ; declare +x PWD OLDPWD HOME HOSTNAME PATH LS_COLORS SHLVL ;  declare -x > /shared/.parameters/env "
            ],
            "workdir": "/shared",
            "stdout": "/outputs/mkdir_stdout.log",
            "stderr": "/outputs/mkdir_stderr.log",
            "ignore_error": false
        },
        {
            "image": "ubuntu:24.04",
            "command": [
                "/bin/bash",
                "-c",
                "source /shared/.parameters/env ; exec > /shared/config.wfex.stage ; echo 'params:' && echo '  an_input:' && echo '    c-l-a-s-s: File' && echo '    preferred-name: input.hello' && echo '    clonable: false' && echo '    cacheable: false' && echo '    url: file://'\"${_input__an_input}\""
            ],
            "workdir": "/shared",
            "stdout": "/outputs/tes_logs/prepare_params_stdout.log",
            "stderr": "/outputs/tes_logs/prepare_params_stderr.log",
            "ignore_error": false
        },
        {
            "image": "ubuntu:24.04",
            "command": [
                "cat",
                "/shared/config.wfex.stage"
            ],
            "workdir": "/shared",
            "stdout": "/outputs/tes_logs/cat_params_stdout.log",
            "stderr": "/outputs/tes_logs/cat_params_stderr.log",
            "ignore_error": false
        },
        {
            "image": "ghcr.io/inab/wfexs-backend:1.0.12",
            "command": [
                "/bin/bash",
                "-c",
                "source /shared/.parameters/env ; gocryptfs -nosyslog -ro -q -extpass 'cat /shared/.parameters/.credentials' \"${ENCRYPTED_PATH}\" \"${DECRYPTED_PATH}\" >> /outputs/tes_logs/gocryptfs-logs.txt 2>&1 ; WfExS-backend import -R \"$WRROC\" -s --strict-reproducibility --reproducibility-level 3 --no-disclosable-default --no-clonable-default -W /shared/config.wfex.stage --save-workdir-id /shared/workdir_id_stage.txt"
            ],
            "workdir": "/shared",
            "stdout": "/outputs/tes_logs/import_stdout.log",
            "stderr": "/outputs/tes_logs/import_stderr.log",
            "ignore_error": false
        },
        {
            "image": "ghcr.io/inab/wfexs-backend:1.0.12",
            "command": [
                "/bin/bash",
                "-c",
                "source /shared/.parameters/env ; gocryptfs -nosyslog -ro -q -extpass 'cat /shared/.parameters/.credentials' \"${ENCRYPTED_PATH}\" \"${DECRYPTED_PATH}\" >> /outputs/tes_logs/gocryptfs-logs.txt 2>&1 ; WfExS-backend staged-workdir offline-exec /shared/workdir_id_stage.txt"
            ],
            "workdir": "/shared",
            "stdout": "/outputs/tes_logs/exec_stdout.log",
            "stderr": "/outputs/tes_logs/exec_stderr.log",
            "ignore_error": false
        },
        {
            "image": "ghcr.io/inab/wfexs-backend:1.0.12",
            "command": [
                "/bin/bash",
                "-c",
                "source /shared/.parameters/env ; gocryptfs -nosyslog -ro -q -extpass 'cat /shared/.parameters/.credentials' \"${ENCRYPTED_PATH}\" \"${DECRYPTED_PATH}\" >> /outputs/tes_logs/gocryptfs-logs.txt 2>&1 ; WfExS-backend staged-workdir --workflow --containers create-prov-crate /shared/workdir_id_stage.txt /outputs/output_wrroc.zip"
            ],
            "workdir": "/shared",
            "stdout": "/outputs/tes_logs/prov_crate_stdout.log",
            "stderr": "/outputs/tes_logs/prov_crate_stderr.log",
            "ignore_error": false
        },
        {
            "image": "ghcr.io/inab/wfexs-backend:1.0.12",
            "command": [
                "/bin/bash",
                "-c",
                "source /shared/.parameters/env ; gocryptfs -nosyslog -ro -q -extpass 'cat /shared/.parameters/.credentials' \"${ENCRYPTED_PATH}\" \"${DECRYPTED_PATH}\" >> /outputs/tes_logs/gocryptfs-logs.txt 2>&1 ; WfExS-backend staged-workdir shell /shared/workdir_id_stage.txt -- bash -c \"cp -dpLr outputs/* meta/outputs/*/stats /outputs/analysis_outputs\""
            ],
            "workdir": "/shared",
            "stdout": "/outputs/tes_logs/outputs_cp_stdout.log",
            "stderr": "/outputs/tes_logs/outputs_cp_stderr.log",
            "ignore_error": false
        }
    ],
    "tags": {
        "Project": "EoscEntrustDemo",
        "tres": "BSC"
    }
}
