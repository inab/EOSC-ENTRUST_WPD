{
    "name": "WfExS TES template HELLO WORLD complete v6",
    "description": "Complete TES template v6 for execution hello world.",
    "outputs": [
        {
            "name": "outputs",
            "description": "The WRROC and outputs dir",
            "path": "/outputs",
            "url": "s3://",
            "type": "DIRECTORY"
        }
    ],
    "volumes": [
        "/shared/"
    ],
    "executors": [
        {
            "image": "ubuntu:24.04",
            "env": {
                "input__an_input": "SRR7890919_WES_HCC1395BL-EA_normal_1.fastq.gz",
                "__analysis__": "hello"
            },
            "command": [
                "/bin/bash",
                "-c",
                "export XDG_CACHE_HOME=\"/workflows/${__analysis__}/side_caches\" ; export WFEXS_CONFIG_FILE=\"/workflows/${__analysis__}/funnel_tre_wfexs_restricted.yaml\" ; export WRROC=\"/workflows/${__analysis__}/wrroc.zip\" ; export ENCRYPTED_PATH=\"/inputs/${TRE_INPUT_ID}\" ; export DECRYPTED_PATH=\"/shared/datasets/${TRE_INPUT_ID}\" ; export _input__an_input=\"${DECRYPTED_PATH}/$input__an_input\" ; mkdir -p /shared/tes_logs \"${DECRYPTED_PATH}\" /shared/.parameters ; chmod go+w /shared/tes_logs ; chmod ugo+rwxt /tmp ; echo \"$TRE_INPUT_CREDENTIALS\" > /shared/.parameters/.credentials ; declare +x PWD OLDPWD HOME HOSTNAME PATH LS_COLORS SHLVL ;  declare -x > /shared/.parameters/env "
            ],
            "workdir": "/shared",
            "stdout": "/shared/mkdir_stdout.log",
            "stderr": "/shared/mkdir_stderr.log",
            "ignore_error": false
        },
        {
            "image": "ubuntu:24.04",
            "command": [
                "/bin/bash",
                "-c",
                "source /shared/.parameters/env ; exec > /shared/config.wfex.stage ; echo 'params:' && echo '  an_input:' && echo '    c-l-a-s-s: File' && echo '    preferred-name: input.hello' && echo '    clonable: false' && echo '    cacheable: false' && echo '    url: file://'\"${_input__an_input}\""
            ],
            "workdir": "/shared",
            "stdout": "/shared/tes_logs/prepare_params_stdout.log",
            "stderr": "/shared/tes_logs/prepare_params_stderr.log",
            "ignore_error": false
        },
        {
            "image": "ubuntu:24.04",
            "command": [
                "cat",
                "/shared/config.wfex.stage"
            ],
            "workdir": "/shared",
            "stdout": "/shared/tes_logs/cat_params_stdout.log",
            "stderr": "/shared/tes_logs/cat_params_stderr.log",
            "ignore_error": false
        },
        {
            "image": "ghcr.io/inab/wfexs-backend:1.0.12",
            "command": [
                "/bin/bash",
                "-c",
                "source /shared/.parameters/env ; gocryptfs -nosyslog -ro -q -extpass 'cat /shared/.parameters/.credentials' \"${ENCRYPTED_PATH}\" \"${DECRYPTED_PATH}\" >> /shared/tes_logs/gocryptfs-logs.txt 2>&1 ; WfExS-backend import -R \"$WRROC\" -s --strict-reproducibility --reproducibility-level 3 --no-disclosable-default --no-clonable-default -W /shared/config.wfex.stage --save-workdir-id /shared/workdir_id_stage.txt"
            ],
            "workdir": "/shared",
            "stdout": "/shared/tes_logs/import_stdout.log",
            "stderr": "/shared/tes_logs/import_stderr.log",
            "ignore_error": false
        },
        {
            "image": "ghcr.io/inab/wfexs-backend:1.0.12",
            "command": [
                "/bin/bash",
                "-c",
                "source /shared/.parameters/env ; gocryptfs -nosyslog -ro -q -extpass 'cat /shared/.parameters/.credentials' \"${ENCRYPTED_PATH}\" \"${DECRYPTED_PATH}\" >> /shared/tes_logs/gocryptfs-logs.txt 2>&1 ; WfExS-backend staged-workdir offline-exec /shared/workdir_id_stage.txt"
            ],
            "workdir": "/shared",
            "stdout": "/shared/tes_logs/exec_stdout.log",
            "stderr": "/shared/tes_logs/exec_stderr.log",
            "ignore_error": false
        },
        {
            "image": "ghcr.io/inab/wfexs-backend:1.0.12",
            "command": [
                "/bin/bash",
                "-c",
                "source /shared/.parameters/env ; gocryptfs -nosyslog -ro -q -extpass 'cat /shared/.parameters/.credentials' \"${ENCRYPTED_PATH}\" \"${DECRYPTED_PATH}\" >> /shared/tes_logs/gocryptfs-logs.txt 2>&1 ; WfExS-backend staged-workdir --workflow --containers create-prov-crate /shared/workdir_id_stage.txt /outputs/output_wrroc.zip"
            ],
            "workdir": "/shared",
            "stdout": "/shared/tes_logs/prov_crate_stdout.log",
            "stderr": "/shared/tes_logs/prov_crate_stderr.log",
            "ignore_error": false
        },
        {
            "image": "quay.io/biocontainers/unzip:6.0--2",
            "command": [
                "unzip",
                "/outputs/output_wrroc.zip",
                "ro-crate-metadata.json"
            ],
            "workdir": "/shared",
            "stdout": "/shared/tes_logs/unzip_crate_metadata_stdout.log",
            "stderr": "/shared/tes_logs/unzip_crate_metadata_stderr.log",
            "ignore_error": false
        },
        {
            "image": "quay.io/biocontainers/jq:1.8.2",
            "command": [
                "/bin/bash",
                "-c",
                "mkdir -p rocrate_validations && jq -Rs '{crate_json: .}' ro-crate-metadata.json > rocrate_validations/core_rocrate_validation.json && for profile_name in workflow-ro-crate-1.0 process-run-crate-0.5 workflow-run-crate-0.5 ; do jq -Rs --arg profile_name \"$profile_name\" '{crate_json: ., profile_name: $profile_name}' ro-crate-metadata.json > rocrate_validations/\"${profile_name}\"_validation.json ; done"
            ],
            "workdir": "/shared",
            "stdout": "/shared/tes_logs/jq_metadata_stdout.log",
            "stderr": "/shared/tes_logs/jq_metadata_stderr.log",
            "ignore_error": false
        },
        {
            "image": "quay.io/biocontainers/curl:7.45.0--2",
            "command": [
                "/bin/bash",
                "-c",
                "mkdir -p rocrate_validation_reports && for validation in rocrate_validations/*json ; do curl -X POST \"$TRE_VALIDATION_SERVICE\" -H 'Content-Type: application/json' -o rocrate_validation_reports/\"$(basename \"$validation\")\" -d @\"$validation\" ; done && tar chf /outputs/rocrate_validation_logs.tar rocrate_validations"
            ],
            "workdir": "/shared",
            "stdout": "/shared/tes_logs/curl_validate_stdout.log",
            "stderr": "/shared/tes_logs/curl_validate_stderr.log",
            "ignore_error": false
        },
        {
            "image": "ghcr.io/inab/wfexs-backend:1.0.12",
            "command": [
                "/bin/bash",
                "-c",
                "source /shared/.parameters/env ; gocryptfs -nosyslog -ro -q -extpass 'cat /shared/.parameters/.credentials' \"${ENCRYPTED_PATH}\" \"${DECRYPTED_PATH}\" >> /shared/tes_logs/gocryptfs-logs.txt 2>&1 ; WfExS-backend staged-workdir shell /shared/workdir_id_stage.txt -- bash -c \"tar chf /outputs/analysis_outputs.tar outputs/* meta/outputs/*/stats \""
            ],
            "workdir": "/shared",
            "stdout": "/shared/tes_logs/outputs_cp_stdout.log",
            "stderr": "/shared/tes_logs/outputs_cp_stderr.log",
            "ignore_error": false
        },
        {
            "image": "ghcr.io/inab/wfexs-backend:1.0.12",
            "command": [
                "/bin/bash",
                "-c",
                "tar czhf /outputs/tes_logs.tar.gz /shared/tes_logs/ /shared/mkdir*.log"
            ],
            "workdir": "/shared",
            "ignore_error": true
        }
    ],
    "tags": {
        "Project": "EoscEntrustDemo",
        "tres": "BSC"
    }
}
