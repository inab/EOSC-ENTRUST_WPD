{
    "name": "WfExS TES template complete v2",
    "description": "Complete TES template v2 for executing Sarek test full.",
    "inputs": [
      {
      "name": "input:1:patient",
      "description": "First line patient",
      "content": "HCC1395",
      "path": "/data/input_1_patient"
      },
      {
      "name": "input:1:sex",
      "description": "First line patient sex",
      "content": "XX",
      "path": "/data/input_1_sex"
      },
      {
      "name": "input:1:status",
      "description": "First line patient status",
      "content": "0",
      "path": "/data/input_1_status"
      },
      {
      "name": "input:1:sample",
      "description": "First line patient sample",
      "content": "HCC1395N",
      "path": "/data/input_1_sample"
      },
      {
      "name": "input:1:lane",
      "description": "First line patient lane",
      "content": "1",
      "path": "/data/input_1_lane"
      },
      {
      "name": "input:1:fastq_1",
      "description": "First line patient (FastQ 1)",
      "url": "file:///data/entrust/FILE_SCHEME/SRR7890919_WES_HCC1395BL-EA_normal_1.fastq.gz",
      "path": "/data/input_1_fastq_1.fastq.gz",
      "type": "FILE",
      "streamable": true
      },
      {
      "name": "input:1:fastq_2",
      "description": "First line patient (FastQ 2)",
      "url": "file:///data/entrust/FILE_SCHEME/SRR7890919_WES_HCC1395BL-EA_normal_2.fastq.gz",
      "path": "/data/input_1_fastq_2.fastq.gz",
      "type": "FILE",
      "streamable": true
      },
      {
      "name": "input:2:patient",
      "description": "Second line patient",
      "content": "HCC1395",
      "path": "/data/input_2_patient"
      },
      {
      "name": "input:2:sex",
      "description": "Second line patient sex",
      "content": "XX",
      "path": "/data/input_2_sex"
      },
      {
      "name": "input:2:status",
      "description": "Second line patient status",
      "content": "1",
      "path": "/data/input_2_status"
      },
      {
      "name": "input:2:sample",
      "description": "Second line patient sample",
      "content": "HCC1395T",
      "path": "/data/input_2_sample"
      },
      {
      "name": "input:2:lane",
      "description": "Second line patient lane",
      "content": "1",
      "path": "/data/input_2_lane"
      },
      {
      "name": "input:2:fastq_1",
      "description": "Second line patient (FastQ 1)",
      "url": "file:///data/entrust/FILE_SCHEME/SRR7890918_WES_HCC1395-EA_tumor_1.fastq.gz",
      "path": "/data/input_2_fastq_1.fastq.gz",
      "type": "FILE",
      "streamable": true
      },
      {
      "name": "input:2:fastq_2",
      "description": "Second line patient (FastQ 2)",
      "url": "file:///data/entrust/FILE_SCHEME/SRR7890918_WES_HCC1395-EA_tumor_2.fastq.gz",
      "path": "/data/input_2_fastq_2.fastq.gz",
      "type": "FILE",
      "streamable": true
      },
     {
        "name": "__side_caches__",
        "description": "WfExS side caches snapshot",
        "url":"file:///data/entrust/FILE_SCHEME/wfexs_side_caches-20260831.tar.gz", 
        "path": "/container/wfexs_side_caches-snapshot.tar.gz"
     },
     {
        "name": "__min_config__",
        "description": "WfExS min config (tailored for a 12 core VM)",
        "url":"file:///data/entrust/FILE_SCHEME/wfexs_min_config-20260831.tar.gz", 
        "path": "/container/wfexs_min_config.tar.gz"
     },
     {
        "name": "__pre-populated_cache__",
        "description": "WfExS pre-populated cache (tailored for Sarek workflow)",
        "url":"file:///data/entrust/FILE_SCHEME/wfexs_prepopulated_cache-20260907.tar.gz", 
        "path": "/container/wfexs_prepopulated_cache.tar.gz"
     },
      {
         "name": "__workflow__",
         "description": "Workflow Run RO-Crate workflow snapshot (with pre-configured datasets)",
         "url":"file:///data/entrust/FILE_SCHEME/rocrate-sarek_test.zip", 
         "path": "/container/wrroc.zip"
      }
    ],
    "outputs": [
      {
        "name": "outputs",
        "description": "The WRROC and outputs dir",
        "path": "/outputs",
        "url": "file:///data/entrust/FILE_SCHEME/EXPORT_SAREK_v2",
        "type": "DIRECTORY"
      }
    ],
    "volumes": [
        "/shared/"
    ], 
    "executors": [
	{
		"image": "ubuntu:24.04",
		"command": [
			"/bin/bash",
			"-c",
			"mkdir WfExS && cd WfExS && tar xf /container/wfexs_side_caches-snapshot.tar.gz && tar xf /container/wfexs_min_config.tar.gz && tar xf /container/wfexs_prepopulated_cache.tar.gz"
		],
		"workdir": "/shared",
		"stdout": "/outputs/extract_layout_stdout.log",
		"stderr": "/outputs/extract_layout_stderr.log",
		"ignore_error": false
	},
      {
         "image": "ubuntu:24.04",
         "command": [
           "/bin/bash",
           "-c",
           "echo 'patient,sex,status,sample,lane,fastq_1,fastq_2' > /shared/tab_input.txt ; echo \"$(</data/input_1_patient),$(</data/input_1_sex),$(</data/input_1_status),$(</data/input_1_sample),$(</data/input_1_lane),file:///data/input_1_fastq_1.fastq.gz,file:///data/input_1_fastq_2.fastq.gz\" >> /shared/tab_input.txt ; echo \"$(</data/input_2_patient),$(</data/input_2_sex),$(</data/input_2_status),$(</data/input_2_sample),$(</data/input_2_lane),file:///data/input_2_fastq_1.fastq.gz,file:///data/input_2_fastq_2.fastq.gz\" >> /shared/tab_input.txt"
         ],
         "workdir": "/shared",
         "stdout": "/outputs/prepare_input_stdout.log",
         "stderr": "/outputs/prepare_input_stderr.log",
         "ignore_error": false
       },
       {
         "image": "ubuntu:24.04",
         "command": [
            "cat",
            "/shared/tab_input.txt"
         ],
         "workdir": "/shared",
         "stdout": "/outputs/cat_tab_input_stdout.log",
         "stderr": "/outputs/cat_tab_input_stderr.log",
         "ignore_error": false
        },
        {
         "image": "ubuntu:24.04",
         "command": [
           "/bin/bash",
           "-c",
           "echo 'params:' > config.wfex.stage && echo '  input:' >> config.wfex.stage && echo '    c-l-a-s-s: ContentWithURIs' >> config.wfex.stage && echo '    preferred-name: input.csv' >> config.wfex.stage && echo '    clonable: false' >> config.wfex.stage && echo '    cacheable: false' >> config.wfexs.stage && echo '    url: file:///shared/tab_input.txt' >> config.wfex.stage && echo '    tabular:'  >> config.wfex.stage && echo '      uri-columns:'  >> config.wfex.stage && echo '        - 5'  >> config.wfex.stage && echo '        - 6'  >> config.wfex.stage && echo '      column-sep: \",\"'  >> config.wfex.stage && echo '      header-rows: 1'  >> config.wfex.stage"
         ],
         "workdir": "/shared",
         "stdout": "/outputs/prepare_params_stdout.log",
         "stderr": "/outputs/prepare_params_stderr.log",
         "ignore_error": false
       },
     {
      "image": "ubuntu:24.04",
      "command": [
         "cat",
         "/shared/config.wfex.stage"
      ],
      "workdir": "/shared",
      "stdout": "/outputs/cat_params_stdout.log",
      "stderr": "/outputs/cat_params_stderr.log",
      "ignore_error": false
     },
     {
        "image": "ghcr.io/inab/wfexs-backend:1.0.10",
        "env": {
            "XDG_CACHE_HOME": "/shared/WfExS/side_caches",
            "WFEXS_CONFIG_FILE": "/shared/WfExS/funnel_container_wfexs_restricted.yaml"
        },
        "command": [
            "WfExS-backend",
            "import",
            "-R","/container/wrroc.zip",
            "-s",
            "--strict-reproducibility",
            "--reproducibility-level","3",
            "-W", "/shared/config.wfex.stage",
            "--save-workdir-id",
            "/shared/workdir_id_stage.txt"
        ],
        "workdir": "/shared",
        "stdout": "/outputs/import_stdout.log",
        "stderr": "/outputs/import_stderr.log",
        "ignore_error": false
     },
     {
        "image": "ghcr.io/inab/wfexs-backend:1.0.10",
        "env": {
            "XDG_CACHE_HOME": "/shared/WfExS/side_caches",
            "WFEXS_CONFIG_FILE": "/shared/WfExS/funnel_container_wfexs_restricted.yaml"
        },
        "command": [
            "WfExS-backend",
            "staged-workdir",
            "offline-exec",
            "/shared/workdir_id_stage.txt"
        ],
        "workdir": "/shared",
        "stdout": "/outputs/exec_stdout.log",
        "stderr": "/outputs/exec_stderr.log",
        "ignore_error": false
     },
     {
        "image": "ghcr.io/inab/wfexs-backend:1.0.10",
        "env": {
            "XDG_CACHE_HOME": "/shared/WfExS/side_caches",
            "WFEXS_CONFIG_FILE": "/shared/WfExS/funnel_container_wfexs_restricted.yaml"
        },
        "command": [
            "WfExS-backend",
            "staged-workdir",
            "--workflow",
            "--containers", 
            "create-prov-crate",
            "/shared/workdir_id_stage.txt",
            "/outputs/sarek_wrroc.zip"
        ],
        "workdir": "/shared",
        "stdout": "/outputs/prov_crate_stdout.log",
        "stderr": "/outputs/prov_crate_stderr.log",
        "ignore_error": false
     },
     {
         "image": "ghcr.io/inab/wfexs-backend:1.0.10",
        "env": {
            "XDG_CACHE_HOME": "/shared/WfExS/side_caches",
            "WFEXS_CONFIG_FILE": "/shared/WfExS/funnel_container_wfexs_restricted.yaml"
        },
         "command": [
         "WfExS-backend",
         "staged-workdir",
         "shell",
         "/shared/workdir_id_stage.txt",
         "--",
         "cp", "-dpLr", "outputs", "/outputs/analysis_outputs"
         ],
         "workdir": "/shared",
         "stdout": "/outputs/outputs_cp_stdout.log",
         "stderr": "/outputs/outputs_cp_stderr.log",
         "ignore_error": false
     }  
    ],
    "tags": 
     {
        "Project": "EoscEntrustDemo",
        "tres": "Nottingham TRE 02|BSC"
     }
}
